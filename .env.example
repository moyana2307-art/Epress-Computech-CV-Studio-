# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file or share its contents.

# ---------- Backend server ----------
PORT=5000

# ---------- MySQL database ----------
# XAMPP default: user "root" with no password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=epress_cv_studio
# Set to "true" when your database requires TLS (Aiven, TiDB Cloud, ...).
DB_SSL=false

# ---------- AI providers ----------
# Add a key under any provider you want to use. The CV generator shows a
# provider picker for every provider that has a key. Leave all keys empty to
# use the app without AI.

# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.6-flash

# Anthropic Claude: https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=
CLAUDE_API_BASE_URL=https://api.anthropic.com/v1
CLAUDE_MODEL=claude-sonnet-4-6
# Required only when the key has access to multiple workspaces.
CLAUDE_WORKSPACE_ID=

# Which provider to preselect in the generator (gemini or claude). Optional.
AI_PROVIDER=gemini

# ---------- Generic provider (optional / advanced) ----------
# A catch-all OpenAI-compatible endpoint for anything else (OpenAI, Groq,
# OpenRouter, a local Ollama, ...). Only used when AI_API_KEY is set.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_LABEL=

# ---------- Auth (JWT) ----------
# A long random string used to sign login tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# ---------- Frontend (optional) ----------
# The public URL of the backend API, used by the Next.js frontend.
NEXT_PUBLIC_API_URL=http://localhost:5000
